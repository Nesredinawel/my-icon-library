{
  "name": " nasicon-react",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json"
  },
  "exports": {
    "./outline": {
      "types": "./dist/outline/index.d.ts",
      "import": "./dist/outline/index.mjs",
      "require": "./dist/outline/index.cjs"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.mjs",
      "require": "./dist/solid/index.cjs"
    },
    "./duotone": {
      "types": "./dist/duotone/index.d.ts",
      "import": "./dist/duotone/index.mjs",
      "require": "./dist/duotone/index.cjs"
    },
    "./monochrome": {
      "types": "./dist/monochrome/index.d.ts",
      "import": "./dist/monochrome/index.mjs",
      "require": "./dist/monochrome/index.cjs"
    }
  }
}