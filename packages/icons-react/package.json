{
  "name": "@nasicons/icons-react",
  "version": "3.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": ">=17"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./outline": {
      "types": "./dist/outline/index.d.ts",
      "import": "./dist/outline/index.mjs",
      "require": "./dist/outline/index.cjs"
    },
    "./outline/*": {
      "types": "./dist/outline/*.d.ts",
      "import": "./dist/outline/*.mjs",
      "require": "./dist/outline/*.cjs"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.mjs",
      "require": "./dist/solid/index.cjs"
    },
    "./solid/*": {
      "types": "./dist/solid/*.d.ts",
      "import": "./dist/solid/*.mjs",
      "require": "./dist/solid/*.cjs"
    },
    "./duotone": {
      "types": "./dist/duotone/index.d.ts",
      "import": "./dist/duotone/index.mjs",
      "require": "./dist/duotone/index.cjs"
    },
    "./duotone/*": {
      "types": "./dist/duotone/*.d.ts",
      "import": "./dist/duotone/*.mjs",
      "require": "./dist/duotone/*.cjs"
    },
    "./monochrome": {
      "types": "./dist/monochrome/index.d.ts",
      "import": "./dist/monochrome/index.mjs",
      "require": "./dist/monochrome/index.cjs"
    },
    "./monochrome/*": {
      "types": "./dist/monochrome/*.d.ts",
      "import": "./dist/monochrome/*.mjs",
      "require": "./dist/monochrome/*.cjs"
    }
  }
}
