{
  "name": "nasicon-lottie-react",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "dependencies": {
    "lottie-react": "^2.4.0",
    "nasicon-lottie-json": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/build-lottie-react-dts.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs",
      "require": "./dist/*/index.cjs"
    }
  }
}
