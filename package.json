{
  "name": "my-icon-library",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:optimize": "node scripts/optimize-svgs.mjs",
    "icons:meta": "node scripts/build-metadata.mjs",
    "icons:react": "node scripts/generate-react.mjs",
    "build:packages": "pnpm --filter \"./packages/icons-react\" build",
    "build": "pnpm icons:optimize && pnpm icons:meta && pnpm icons:react && pnpm build:packages",
    "demo:dev": "pnpm --filter nasicons-demo dev",
    "demo": "pnpm build && pnpm demo:dev",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "release:full": "pnpm build && pnpm changeset version && pnpm changeset publish",
    "format": "prettier --write .",
    "check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "fast-glob": "^3.3.2",
    "prettier": "^3.3.3",
    "svgo": "^3.3.2",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@nasicons/icons-react": "^2.0.0",
    "@nasicons/icons-svg": "^2.0.0"
  },
  "version": "0.0.3"
}
